# ========================================================
# Configuration du Bot Discord Chabeille
# ========================================================

# Token d'authentification du bot (obligatoire)
# Récupérable sur https://discord.com/developers/applications
DISCORD_TOKEN=TOKEN

# ID du serveur Discord (optionnel mais recommandé pour le dev/prod)
# Si spécifié, les commandes slash sont synchronisées instantanément sur ce serveur.
# Sinon, elles sont synchronisées globalement (peut prendre jusqu'à 1 heure pour se propager).
GUILD_ID=

# Noms des rôles requis pour les permissions (insensible à la casse)
ROLE_BUREAU=bureau
ROLE_MEMBRE=Membre

# Assigner automatiquement le rôle Discord "Membre" lors de la commande /member (True/False)
AUTO_ASSIGN_MEMBER_ROLE=true

# Chemin vers la base de données SQLite
DB_PATH=data/members.db

# Niveau de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
